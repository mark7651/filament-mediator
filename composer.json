{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mark7651/filament-mediator",
    "description": "A media library for Filament panels: a wall of files, a form field and an editor button.",
    "type": "library",
    "keywords": [
        "laravel",
        "filament",
        "media",
        "media-library",
        "glide",
        "livewire"
    ],
    "homepage": "https://github.com/mark7651/filament-mediator",
    "license": "MIT",
    "authors": [
        {
            "name": "Max",
            "email": "37314381+mark7651@users.noreply.github.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mark7651/filament-mediator/issues",
        "source": "https://github.com/mark7651/filament-mediator"
    },
    "require": {
        "php": "^8.3",
        "enshrined/svg-sanitize": "^0.22",
        "filament/filament": "^5.7",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "intervention/image": "^3.11",
        "league/glide": "^3.2",
        "livewire/livewire": "^4.4"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "Mediator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mediator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mediator\\MediatorServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
